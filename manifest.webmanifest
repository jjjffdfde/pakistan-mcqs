{
  "id": "/",
  "name": "Pakistan MCQs Hub - Free MCQ Practice Platform",
  "short_name": "MCQs Hub",
  "description": "Offline-first MCQ practice platform for PPSC, FPSC, NTS, OTS, CSS, PMS and all Pakistani competitive exams. Installable on web, Android and desktop.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#013710",
  "theme_color": "#01411c",
  "categories": ["education", "productivity"],
  "prefer_related_applications": false,
