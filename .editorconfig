# EditorConfig — Pakistan MCQS Hub
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{js,cjs,mjs,json,md,yml,yaml,html,css,webmanifest,xml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sql,sh,cmd}]
indent_style = tab

[*.sqlite]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
