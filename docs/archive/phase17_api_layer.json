        },
        "direction": {
          "type": "string",
          "description": "upstream or downstream",
          "enum": [
            "upstream",
            "downstream"
          ],
          "default": "upstream"
        }
      },
      "implementation": "BFS traversal of kg_prerequisites and kg_concept_relations edges",
      "data_source": "kg_prerequisites, kg_concept_relations, kg_concepts"
