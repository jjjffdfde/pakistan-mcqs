# ============================================================
# .env.example - Pakistan MCQs Hub
# Copy to .env and adjust. NEVER commit the real .env file.
# The project runs with zero configuration; these are optional.
# ============================================================

# Port for the optional Node API/static server (server.js legacy) 
MCQS_PORT=8765

# Port for the runtime-v2 (JSON/NDJSON file engine) API/static server
MCQS_JSON_PORT=8766

# Base URL of the API used by some tooling scripts
MCQS_API=http://localhost:8766

# JSON/NDJSON data + index directories for runtime-v2 (defaults:
# database/data and runtime-v2/indexes). Point both at a fixture
# directory to run tests/monitoring against synthetic data.
# MCQS_JSON_DATA_DIR=./.phase40-fixture/data
# MCQS_JSON_INDEX_DIR=./.phase40-fixture/indexes

# Phase 28 audit server port (scripts/phase28/server.cjs)
P28_PORT=8799

# Path to the Chrome/Chromium executable for headless audit runs
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe