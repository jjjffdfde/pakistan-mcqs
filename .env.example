# ============================================================
# .env.example - Pakistan MCQs Hub
# Copy to .env and adjust. NEVER commit the real .env file.
# The project runs with zero configuration; these are optional.
# ============================================================

# Port for the optional Node API/static server (server.js)
MCQS_PORT=8765

# Base URL of the API used by some tooling scripts
MCQS_API=http://localhost:8765

# Alternate SQLite path for tests / monitoring
# MCQS_TEST_DB=./db/pakistan-mcqs.sqlite

# Phase 28 audit server port (scripts/phase28/server.cjs)
P28_PORT=8799

# Path to the Chrome/Chromium executable for headless audit runs
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
