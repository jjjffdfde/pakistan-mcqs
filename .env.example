# ============================================================
# .env.example - Pakistan MCQs Hub
# Copy to .env and adjust. NEVER commit the real .env file.
# The project runs with zero configuration; these are optional.
# ============================================================

# Port for the optional Node API/static server (server.js legacy)
MCQS_PORT=8765

# Port for the runtime-v2 (JSON/NDJSON file engine) API/static server
# (PORT is also honored; PORT wins when both are set)
MCQS_JSON_PORT=8766

# Bind host for runtime-v2. Default 127.0.0.1 (development only);
# in production set to 0.0.0.0 (default when NODE_ENV=production)
# so the platform's reverse proxy can reach it.
# HOST=0.0.0.0
# MCQS_JSON_HOST=0.0.0.0

# Node environment: development | production
# (production sanitizes error messages, binds 0.0.0.0 by default,
#  and restricts CORS to the origins listed in CORS_ORIGIN)
# NODE_ENV=production

# Base URL of the API used by some tooling scripts
MCQS_API=http://localhost:8766

# JSON/NDJSON data + index directories for runtime-v2 (defaults:
# database/data and runtime-v2/indexes). Point both at a fixture
# directory to run tests/monitoring against synthetic data.
# MCQS_JSON_DATA_DIR=./.phase40-fixture/data
# MCQS_JSON_INDEX_DIR=./.phase40-fixture/indexes

# Writable user-data directory for runtime-v2 (answer history,
# profiles, AI coach state). Default <root>/runtime-v2/userdata.
# Persist this directory between deploys; it is gitignored.
# MCQS_JSON_USER_DIR=/var/lib/mcqs/userdata

# CORS allowed origins (comma-separated). Defaults already include
# https://jjjffdfde.github.io plus localhost dev origins. Use "*"
# ONLY if you explicitly want to allow every origin.
# CORS_ORIGIN=https://app.example.com,https://admin.example.com

# Bearer token required by admin routes (/api/import, /api/backup,
# /api/restore, /api/export). Empty = admin routes open (local dev).
# Always set a strong value in production.
# MCQS_ADMIN_TOKEN=change-me-strong-random-token

# Max JSON request body bytes (admin imports; default 2MB)
# MCQS_BODY_LIMIT=4194304

# Per-IP rate limits (requests per minute)
# MCQS_API_RATE_LIMIT=600
# MCQS_AI_RATE_LIMIT=120

# Optional external AI provider for the server-side AI seam.
# The AI Coach engine is fully local/file-backed and works without
# these; they are ONLY for future provider-backed features.
# AI_PROVIDER=openai-compatible
# AI_API_URL=https://api.example.com/v1
# AI_API_KEY=never-commit-this
# AI_TIMEOUT_MS=30000
# AI_MAX_RETRIES=1

# Phase 28 audit server port (scripts/phase28/server.cjs)
P28_PORT=8799

# Path to the Chrome/Chromium executable for headless audit runs
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe